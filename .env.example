# Copy this file to .env and fill in the real values for your devices.
# ESP-NOW PMK and LMK must each be exactly 16 ASCII characters.
MESH_CHANNEL=1
MESH_PMK=change-me-16char
MESH_LMK=change-me-16char

# Format:
# MESH_NODE_<N>=<role>,<logical_id>,<sta_mac>,<label>
# role: Panel, Fans, Key, Lights, Unknown
# mac: ESP-NOW uses the Wi-Fi STA MAC address.
MESH_NODE_1=Panel,0,00:00:00:00:00:01,Panel
MESH_NODE_2=Lights,0,00:00:00:00:00:02,Light-01
MESH_NODE_3=Fans,0,00:00:00:00:00:03,Fans
